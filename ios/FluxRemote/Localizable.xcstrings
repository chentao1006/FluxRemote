        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser QR-Code ist für Android. Auf iOS bitte iCloud-Synchronisierung verwenden, um Server-Konfigurationen zwischen Geräten zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
