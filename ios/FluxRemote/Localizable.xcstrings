    "monitor.screenshotPermissionMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen capture requires Screen Recording permission on the Mac side. When you see the system authorization request on your Mac, please click 'Allow' or 'OK'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取屏幕快照需要在 Mac 端授予屏幕录制权限。Mac 端将弹出系统授权请求，请点击“允许”或“确定”以开启快照功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "获取屏幕快照需要在 Mac 端授予屏幕录制权限。Mac 端将弹出系统授权请求，请点击“允许”或“确定”以开启快照功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
